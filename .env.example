# Canonical origin for this site, with no trailing slash.
#
# Used for canonical URLs, the OpenGraph payload, sitemap.xml, and robots.txt.
# Leave it unset and the build falls back to `url` in site.config.ts, so a
# fresh clone builds with no .env file at all.
#
# Set this on your host to the real domain. On a preview deployment, set it to
# the preview URL — otherwise every preview publishes canonicals pointing at
# production, and search engines index the wrong pages.
NEXT_PUBLIC_SITE_URL=https://kestrel.example.com
